BACKEND_URL=http://localhost:4000
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

MONGO_URI=mongodb://localhost:27017/vehicle-state-tax

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=100d
BCRYPT_HASH_SALT=10

# Pay0 (when PAYMENT_GATEWAY=pay0 in Admin Settings)
PAY0_API_BASE_URL=https://api.pay0.shop/apiv1
PAY0_USER_TOKEN=your_pay0_api_key
PAY0_SECRET_KEY=your_pay0_secret_key

SBIEPAY_BASE_URL=https://integration.sbiepay.sbiuat.bank.in
SBIEPAY_API_PATH=/api/transaction/v1
SBIEPAY_ENVIRONMENT=SANDBOX
SBIEPAY_API_KEY=your_sbiepay_api_key
SBIEPAY_API_SECRET=your_sbiepay_api_secret
SBIEPAY_ENCRYPTION_KEY=your_sbiepay_encryption_key
SBIEPAY_MERCHANT_ID=your_7_char_mid
SBIEPAY_LOGGING=false
SBIEPAY_CURRENCY_CODE=INR

# PayIndia (deprecated — use Pay0 or SBIePay)
PAYINDIA_API_BASE_URL=https://www.payindiape.com/api
PAYINDIA_API_TOKEN=your_payindia_api_token

# Razorpay (deprecated — no longer used)
# Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Paygic (deprecated — only needed if using services/paygic.js)
PAYMENT_URL=https://server.paygic.in/api/v2
PAYMENT_MID=your_paygic_merchant_id
PAYMENT_PASSWORD=your_paygic_password

FIREBASE_STORAGE_BUCKET_NAME=your-project.appspot.com
# FIREBASE_SERVICE_ACCOUNT_PATH=

# SMS
SMS_USERNAME=
SMS_SENDER_NAME=
SMS_API_KEY=
SMS_TYPE=

# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_WAID=
WHATSAPP_AUTH_TOKEN=

# Email (user export, notifications)
MAIL_FROM=
MAIL_PASSWORD=
MAILS_USERS_TO=["admin@example.com"]
BCC_MAILS_USERS_TO=[]
